{
  "Urls": "http://localhost:5180",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GisApi": {
    // ===== 地形数据（.ter 瓦片）目录 =====
    // 通用键：任意系统生效；留空则按仓库根推导为 <repoRoot>/data/terrain
    //   例（Windows）： "D:/data/terrain"  或  "D:\\data\\terrain"
    //   例（Linux）：   "/opt/hexfront/data/terrain"
    //   例（相对）：    "data/terrain"（按仓库根解析）
    //   例（环境变量）："%APPDATA%/hexfront/terrain" 或 "$HOME/hexfront/terrain"
    "TerrainDir": "",
    // 系统特化键：仅在对应 OS 生效，优先级高于上面的通用键；都留空则退回通用键
    "TerrainDirWindows": "",
    "TerrainDirLinux": "",

    // ===== 生成数据（jobs/ + grids/）存储根目录 =====
    // 通用键：留空则推导为 <repoRoot>/data/gis-api（其下自动建 jobs/ 与 grids/）
    "DataDir": "",
    "DataDirWindows": "",
    "DataDirLinux": "",

    // 高程来源：auto（瓦片可用即真实，否则合成）/ real（强制真实）/ synthetic（强制合成）
    "DemMode": "auto"
  }
}
