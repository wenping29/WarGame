$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
Icon



# ---- Node.js ----
node_modules/
deploy/dist/


# ---- 构建输出 ----
webapi/[Bb]in/
webapi/[Oo]bj/
webapi/hanjian.db-shm
webapi/hanjian.db-wal

## .NET 编译输出
 
webapi/uploads/

