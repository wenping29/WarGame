# ================================
# HanJianNet · 项目根目录 .gitignore
# 四个子项目共享规则；各子项目专属规则写在各子目录自己的 .gitignore
# ================================

# ---- 操作系统 ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
Icon

# ---- Node.js ----
webfront/node_modules/
webfront/dist/


## .NET 隐藏文件夹
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

server/hexfront.api/bin/
server/hexfront.api/obj/
server/hexfront.core/bin/
server/hexfront.core/obj/
server/hexfront.tests/bin/
server/hexfront.tests/obj/

## 本地配置密钥
server/hexfront.api/appsettings.Development.json
server/hexfront.api/appsettings.Local.json
server/hexfront.api/*.pfx
# 天地图 tk 属于访问凭证，只在本地存在；模板见 data/tianditu.example.json
server/data/tianditu.json
server/data/dem/tiles_z7/
server/data/dem/*.tif
server/data/dem/*.tif.ovr
server/data/gis/*.lpk

# ---- 编辑器 / IDE ----
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user
*.swp
*.swo
*~
.history
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ---- 日志与临时文件 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.old
*.cache

# ---- 环境变量与本地配置 ----

.env.local
.env.development.local
.env.test.local
.env.production.local
# 方案B 双站分离时前端按后端域名编译，域名是环境相关的，不进版本库（模板见 webfront/.env.production.example）
.env.production
# 前端本地开发用的天地图 key 等环境相关配置，同样不进版本库（模板见 webfront/.env.example）
.env
.env.development
*.local.json
appsettings.Local.json
appsettings.*.json
# SQLite 运行时临时文件（WAL 已 checkpoint 合并进主库，这两个是空的副产物）
*.db-shm
*.db-wal
!appsettings.json
!appsettings.Development.json
!appsettings.Production.json


# ---- 证书与密钥 ----
*.pem
*.key
*.crt
*.pfx
*.cer

# ---- 压缩与备份 ----
*.7z
*.zip
*.rar
*.tar
*.gz
*.tgz
*.bak

# ---- 部署产物（由 scripts/deploy/build-package.sh 生成）----
hexfront-deploy-*.tar.gz
scripts/deploy/out/

# ---- 数据库文件（开发 SQLite 按需排除，若要保留种子请注释下面两行） ----
# *.db
# *.sqlite
# *.sqlite3
.tmp-artifacts/t1/bin
.tmp-artifacts/t1/obj

.tmp-verify/bin
.tmp-verify/obj

server/**/[Bb]in/
server/**/[Oo]bj/
server/**/[Dd]ebug/
server/**/[Rr]elease/
server/**/*.binlog


# ---- HexFront.CSharp .NET 编译产物 ----
# 刻意限定在 HexFront.CSharp 下：hexfront/bin/ 是 Dart 引擎源码目录，全局 bin/ 规则会把它们一起吞掉
server/**/[Bb]in/
server/**/[Oo]bj/
server/**/[Dd]ebug/
server/**/[Rr]elease/
server/**/*.binlog

# ---- 前端构建产物（部署用 wwwroot，由打包脚本从 hexfront-react/dist 拷贝进来）----
server/HexFront.Api/wwwroot/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- 兵棋运行期存档（每跑一局验证就新增/改写，不属于代码） ----
server/HexFront.Api/data/

workbuddy/tmp/

server/data/
deploy/out/

# data/
