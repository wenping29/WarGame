# HEXFRONT 运行环境变量（参考模板，由 server-setup.sh 自动生成到 /srv/hexfront/hexfront.env）
# 单进程部署：ASP.NET Core 同时托管 前端静态文件(wwwroot) + REST(/api) + WebSocket(/ws)

# 仓库根：后端用它在运行时定位 server/（内含 data/ 与 HexFront.Api/app.db）
# 这是"向上6层"硬编码定位的替代方案，解包到任意目录都能用。
HF_REPO_ROOT=/srv/hexfront

# 运行环境：Production 会关闭 Swagger/OpenAPI 文档端点
ASPNETCORE_ENVIRONMENT=Production

# 监听地址（单进程直托时用 0.0.0.0 对外；若前面挂 nginx 可改 127.0.0.1:5018）
# 端口也可以直接改 server/HexFront.Api/appsettings.json 的 "Urls" 键（默认 http://0.0.0.0:5018）。
# 两者都配时以本行为准（环境变量优先，见 DEPLOY.md 6.1 节）。
ASPNETCORE_URLS=http://0.0.0.0:5018

# —— 可选覆盖 ——

# 把地图数据单独挂载到别的盘（默认 <HF_REPO_ROOT>/server/data）：
# HF_DATA_DIR=/data/hexfront

# 公网直接访问 5018 端口（浏览器来源与 :5018 不同源）时放开 CORS，填写浏览器地址：
# HF_ALLOWED_ORIGINS=https://your.domain

# 覆盖应用库位置（默认 <HF_REPO_ROOT>/server/HexFront.Api/app.db）：
# HF_APP_DB=/srv/hexfront/server/HexFront.Api/app.db

# 指定 Python 解释器（真实栅格地形生成用；缺省时自动探测 python/python3）：
# HEXGEN_PYTHON=/usr/bin/python3
