# ============================================================================
# HexFront 后端运行环境变量
#
# 用法（二选一）：
#   A. 宝塔面板 → 网站 → hexfront-api → 设置 → 环境变量 → 逐条添加（推荐，图形化）
#   B. 写成本文件（如 /www/wwwroot/wargame/hexfront.env），再由 systemd 加载：
#        EnvironmentFile=/www/wwwroot/wargame/hexfront.env
# ============================================================================

# ---- 数据根目录定位 ------------------------------------------------------
# 指向**解包后的顶层目录**（其下有 server/ 子目录）。本发布包解开后的布局是：
#   /www/wwwroot/wargame/server/HexFront.Api/publish/HexFront.Api.dll
#   /www/wwwroot/wargame/server/HexFront.Api/app.db
#   /www/wwwroot/wargame/server/data/{gis,hexgrids,scenarios,docs}/
#   /www/wwwroot/wargame/deploy/                      ← 部署物料（nginx 配置等）
#   /www/wwwroot/wargame/web/                         ← 前端静态产物
#
# 写成 /www/wwwroot/wargame 即可。
# （新版代码同时接受直接指向 server 目录本身，两种写法都不会拼出 server/server）
HF_REPO_ROOT=/www/wwwroot/wargame

# ---- 运行环境 ------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# ---- 监听地址 ------------------------------------------------------------
# 只监听回环地址，公网流量一律走 nginx（这样才能上 HTTPS，且后端不暴露明文端口）。
# 端口也可以改 publish/appsettings.json 的 "Urls" 键，但**本项优先级更高**。
# ⚠ 改了这里，宝塔 .NET 站点的「端口」字段和 bt-site-dotnet.conf 里的
#   proxy_pass 端口必须**同步**改成同一个值，三处不一致就会连不上。
ASPNETCORE_URLS=http://127.0.0.1:5018

# ---- 允许的前端源（跨域部署必需）----------------------------------------
# 只写 origin：协议 + 域名 + 端口，**不带路径、不带末尾斜杠**。
# 多个源用英文逗号分隔（不要加空格）。
# 这个值必须与前端页面的实际地址完全一致，否则浏览器预检失败、前端一片红色。
HF_ALLOWED_ORIGINS=https://game.example.com
